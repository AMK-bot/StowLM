      "planner_hours = (assumed_before_minutes - assumed_after_minutes) / 60 * replans_per_call",
      "annual_stream_calls = 52 operating weeks * 1 eligible call/week; adoption_calls = floor(9325 * assumed_eligible_adoption_share)",
