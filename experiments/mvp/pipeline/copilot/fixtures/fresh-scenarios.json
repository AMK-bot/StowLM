  "scenarios": [
    {
      "id": "fresh_capped_deck_rebuild",
      "kind": "plain",
      "turns": [
        {
          "message": "Across bay 2, cap each deck stack at 2 occupied tiers.",
          "actions": [
            {
              "tool": "read_instruction",
              "arguments": {
                "sentence": "Across bay 2, cap each deck stack at 2 occupied tiers."
              }
            },
            {
              "say": "$last_text"
            }
          ]
        },
        {
          "message": "The host has confirmed r1. Replan r1, then run the full checker.",
          "actions": [
            {
              "tool": "replan",
              "arguments": {
                "reading_id": "r1"
              }
            },
            {
              "tool": "check_plan",
              "arguments": {}
            },
            {
              "say": "$last_text"
            }
          ],
          "confirm_reading": "r1"
        }
      ],
      "expected_tool_sequence": [
        "read_instruction",
        "replan",
        "check_plan"
      ]
    },
